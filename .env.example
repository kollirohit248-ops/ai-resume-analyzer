# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed with real secrets.

# Anthropic API key used by services/llm_service.py for resume feedback.
LLM_API_KEY=your_api_key_here

# Model name to call. Defaults to claude-sonnet-4-6 if unset.
LLM_MODEL=claude-sonnet-4-6

# HTTP timeout (seconds) for the LLM API call. Defaults to 30 if unset.
LLM_TIMEOUT_SECONDS=30

# Max accepted resume upload size, in MB. Defaults to 5 if unset.
MAX_RESUME_SIZE_MB=5
